APP_NAME="Crazy Life Tourism"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:83/crazy_life_tourism

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=tour
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.com
MAIL_PORT=465
MAIL_USERNAME=1
MAIL_PASSWORD=1
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=11
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_SETTINGS="SMTP"
#EMAIL_SETTINGS="API"
EMAIL_TEST=11
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

API_PREFIX=api
API_VERSION=v1
API_ENCRYPTION_KEY=1

SIGN_UP_RELEASE_TOKEN=true
PASSWORD_RESET_RELEASE_TOKEN=true

JWT_SECRET=1
JWT_TTL=null

SESSION_LIFETIME=129600
#90 days

FILESYSTEM_DRIVER=public
